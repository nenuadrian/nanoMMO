{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release, as the servers and the client ship",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "clang",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "asan",
      "inherits": "clang",
      "displayName": "AddressSanitizer and UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NANOMMO_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "clang",
      "displayName": "ThreadSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NANOMMO_SANITIZE": "thread"
      }
    },
    {
      "name": "fuzz",
      "inherits": "asan",
      "displayName": "The fuzzers, with AddressSanitizer and UBSan",
      "cacheVariables": { "NANOMMO_FUZZ": "ON" }
    },
    {
      "name": "tidy",
      "inherits": "clang",
      "displayName": "The compile commands clang-tidy reads",
      "cacheVariables": { "NANOMMO_FUZZ": "ON" }
    },
    {
      "name": "coverage",
      "inherits": "clang",
      "displayName": "The lines the tests run",
      "cacheVariables": { "NANOMMO_COVERAGE": "ON" }
    },
    {
      "name": "profile",
      "inherits": "release",
      "displayName": "The server with Tracy's zones",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": { "TRACY_ENABLE": "ON" }
    },
    {
      "name": "windows",
      "displayName": "Windows, with MSVC from a Developer PowerShell, and vcpkg's libraries",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "web",
      "displayName": "The client in a browser, with Emscripten's emcmake",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NANOMMO_HOST_PROTOC": "${sourceDir}/build/bin/protoc"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": ["stories_fuzzer", "world_fuzzer"]
    },
    {
      "name": "tidy",
      "configurePreset": "tidy",
      "targets": ["nanommo_protocol", "nanommo_content", "nanommo_client_core"]
    },
    { "name": "coverage", "configurePreset": "coverage" },
    {
      "name": "profile",
      "configurePreset": "profile",
      "targets": ["nanommo_server"]
    },
    { "name": "web", "configurePreset": "web", "targets": ["nanommo_client"] },
    { "name": "windows", "configurePreset": "windows" }
  ],
  "testPresets": [
    { "name": "tests", "hidden": true, "output": { "outputOnFailure": true } },
    { "name": "release", "inherits": "tests", "configurePreset": "release" },
    { "name": "windows", "inherits": "tests", "configurePreset": "windows" },
    { "name": "asan", "inherits": "tests", "configurePreset": "asan" },
    {
      "name": "tsan",
      "inherits": "tests",
      "configurePreset": "tsan",
      "environment": { "TSAN_OPTIONS": "suppressions=${sourceDir}/tsan.supp" }
    },
    {
      "name": "coverage",
      "inherits": "tests",
      "configurePreset": "coverage",
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build-coverage/profiles/%p.profraw"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "windows",
      "steps": [
        { "type": "configure", "name": "windows" },
        { "type": "build", "name": "windows" },
        { "type": "test", "name": "windows" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    }
  ]
}
