# nanoMMO in Romanian. It doesn't address the player, so it picks neither
# "tu" nor "dumneavoastră": a button is a noun, and a sentence impersonal,
# with "se". It writes ș and ț with commas under them, not cedillas.
msgid ""
msgstr ""
"Project-Id-Version: nanoMMO\n"
"Language: ro\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : (n==0 || (n%100 > 0 && n%100 < 20)) ? 1 : 2);\n"

