# The trailer's shots, in the order they're cut together. Times in a camera
# key or a pace are the film's seconds; times in a cast, a leg or a charge are
# the game's.

# ---- The world --------------------------------------------------------------

# Down from a low sun through the clouds to the Meadows.
shots {
  id: "sky-open"
  land: "Meadows"
  seconds: 8
  ease: 0.7
  sky { fog_near: 250 fog_far: 700 sun { x: -0.3 y: 0.42 z: -0.9 } cloudiness: 0.7 }
  camera { at: 0 eye { x: 0 z: 30 up: 40 sea: true } look { x: -89 z: -237 up: 160 sea: true } fov: 55 }
  camera { at: 8 eye { x: 0 z: 12 up: 34 sea: true } look { x: -30 z: -200 up: 8 sea: true } }
  tall { at: 0 eye { x: 0 z: 30 up: 40 sea: true } look { x: -89 z: -237 up: 160 sea: true } fov: 65 }
  tall { at: 8 eye { x: 0 z: 12 up: 34 sea: true } look { x: -30 z: -200 up: 0 sea: true } }
}

# Up from the stones of the gate to the Ashlands, as two players run through,
