# Quiet shots of the world under its sky: someone stands with their back to
# us, and we look over their shoulder at what they're watching, as the camera
# drifts in. The sound is the game's own: the weather, the time of day, and
# its music under them. Times are the film's seconds.

# ---- The Meadows ------------------------------------------------------------

# The sun going down over the sea, in a light rain.
shots {
  id: "rain-at-sunset"
  land: "Meadows"
  seconds: 50
  sky { day: 0.733 days: 0.0002 weather: "RAIN" strength: 0.55 }
  players { id: 1 name: "arthur" at { x: -150 z: 55 } level: 12 weapon: 1 wearing: [8, 9, 10] }
  shoulder { player: 1 look { x: -420 z: 150 up: 14 } back: 3.2 back_end: 2.4 up: 2.1 side: 0.7 fov: 50 tall_fov: 64 }
  music: 0.35
  music_from: 0
}

