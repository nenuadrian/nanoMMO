# A new player has the sword in hand, a shirt, trousers and shoes on, and
# three potions in the bag.
starting { item: 1 }
starting { item: 8 }
starting { item: 9 }
starting { item: 10 }
starting { item: 2 count: 3 }

items {
  id: 1
  name: "Sword"
  weapon {
    reach: 1.6
    swing_ms: 2000
    hit_ms: 900
    damage: 15
  }
  equip { slot: SLOT_MAIN_HAND }
  look {
    model: "sword.glb"
