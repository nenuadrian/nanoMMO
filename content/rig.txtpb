    }
    turns {
      joint: RIGHT_LEG
      pitch: -18
      yaw: -16
    }
    turns {
      joint: RIGHT_KNEE
      pitch: 32
    }
    turns {
      joint: LEFT_ARM
      roll: 72
    }
    turns {
      joint: LEFT_FOREARM
