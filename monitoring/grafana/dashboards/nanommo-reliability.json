{
  "uid": "nanommo-reliability",
  "title": "nanoMMO reliability",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Chaos experiments",
        "target": {
          "type": "tags",
          "tags": [
            "chaos"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ticks: error budget left this month",
      "description": "A world owes 20 ticks a second, and the objective is 99.9% of them within 50 ms, so a month's budget is 0.1% of 30 days of ticks: 51,840, as long as 43 minutes frozen. Every 30 seconds a rule records the share of ticks missed over the last minute; that times 20 ticks a second times 30 seconds is the ticks missed (each minute overlaps the next sample's), summed over the 30 days Prometheus keeps, or as many as it has.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum_over_time(world:nanommo_tick_errors:ratio_rate1m[30d]) * 30 * 20 / 51840",
          "legendFormat": "{{world}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Logins: error budget left this month",
      "description": "The objective is 99% of the requests to the login server answered within five seconds, a wrong password counting as answered: 1% may fail or be slow. The share that did over 30 days, or as many as Prometheus has, against that 1%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (1 - sum(increase(nanommo_login_duration_seconds_bucket{result!=\"failed\", le=\"5.0\"}[30d])) / sum(increase(nanommo_login_duration_seconds_count[30d]))) / 0.01",
          "legendFormat": "logins",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Saves: error budget left this month",
      "description": "The objective is MySQL no more than 30 seconds behind Redis 99.9% of the time, so a month's budget is 0.1% of 30 days: 2,592 seconds, 43 minutes. A rule records every 30 seconds whether the saver's last good flush is over 30 seconds old, or the saver's gone; each 1 is 30 seconds spent.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum_over_time(nanommo_saves_stale[30d]) * 30 / 2592",
          "legendFormat": "saves",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Burn rate, over the last hour",
      "description": "How fast each budget goes: at 1, a month's lasts the month. Over an hour at 14.4, 2% of it goes in the hour, and with the last five minutes as fast, that pages, as does 6 over six hours with the last 30 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "world:nanommo_tick_errors:ratio_rate1h / 0.001",
          "legendFormat": "ticks, {{world}}"
        },
        {
          "refId": "B",
          "expr": "nanommo_login_errors:ratio_rate1h / 0.01",
          "legendFormat": "logins"
        },
        {
          "refId": "C",
          "expr": "nanommo_saves_stale:ratio_rate1h / 0.001",
          "legendFormat": "saves"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Burn rate, over the last five minutes",
      "description": "The short window, which has to burn as fast as the long one for an alert, so that one stops soon after the burning does.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "world:nanommo_tick_errors:ratio_rate5m / 0.001",
          "legendFormat": "ticks, {{world}}"
        },
        {
          "refId": "B",
          "expr": "nanommo_login_errors:ratio_rate5m / 0.01",
          "legendFormat": "logins"
        },
        {
          "refId": "C",
          "expr": "nanommo_saves_stale:ratio_rate5m / 0.001",
          "legendFormat": "saves"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ticks a second, and those on time",
      "description": "Out of the 20 a second each world owes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (world) (rate(nanommo_tick_duration_seconds_count[30s]))",
          "legendFormat": "{{world}}, all"
        },
        {
          "refId": "B",
          "expr": "sum by (world) (rate(nanommo_tick_duration_seconds_bucket{le=\"0.05\"}[30s]))",
          "legendFormat": "{{world}}, within 50 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Logins a second, by result, as the login server and the bots saw them",
      "description": "The login server counts each request it answers; a request that never reaches it, or never ends, it never counts. The bots count each login from outside, a timeout too.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(nanommo_login_duration_seconds_count[30s]))",
          "legendFormat": "login server: {{result}}"
        },
        {
          "refId": "C",
          "expr": "sum by (result) (rate(nanommo_bot_login_duration_seconds_count[30s]))",
          "legendFormat": "bots: {{result}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(nanommo_login_duration_seconds_bucket[1m])))",
          "legendFormat": "99th percentile, seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Saves: seconds since the last good flush",
      "description": "The saver flushes every five seconds; over 30 seconds is stale.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(nanommo_saver_flushed_timestamp_seconds)",
          "legendFormat": "seconds behind"
        },
        {
          "refId": "B",
          "expr": "max(nanommo_unsaved_players)",
          "legendFormat": "players waiting"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "What the bots see: their newest world's age, 99th percentile",
      "description": "How old the newest world each bot has is: a frozen world grows old.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(nanommo_bot_world_age_seconds_bucket[10s])))",
          "legendFormat": "world age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Bots connected, and players dropped",
      "description": "Players a world let go of without saving them, by why.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(nanommo_bots_connected)",
          "legendFormat": "bots connected"
        },
        {
          "refId": "B",
          "expr": "sum by (world, why) (increase(nanommo_players_dropped_total[1m]))",
          "legendFormat": "dropped in a minute, {{world}}: {{why}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Errors written a minute, by service",
      "description": "Lines on standard error, from Loki.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({stream=\"stderr\"}[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Alerts firing",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (alertname) (ALERTS{alertstate=\"firing\"}) or on () label_replace(vector(0), \"alertname\", \"nothing firing\", \"\", \"\")",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "legend": {
          "showLegend": false
        }
      },
      "description": "Each alert while it fires, in red. When none is, a row says so, as a timeline with no series has nothing to draw."
    }
  ]
}
