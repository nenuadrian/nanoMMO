discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=nanommo"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  forward_to    = [loki.write.loki.receiver]
  relabel_rules = loki.relabel.streams.rules
}

loki.relabel "streams" {
  forward_to = []

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  rule {
    source_labels = ["service", "__meta_docker_container_log_stream"]
    regex         = "(server|frost|server-next|frost-next|login|saver);stderr"
    target_label  = "level"
    replacement   = "error"
  }

  rule {
    source_labels = ["service", "__meta_docker_container_log_stream"]
    regex         = "(server|frost|server-next|frost-next|login|saver);stdout"
    target_label  = "level"
    replacement   = "info"
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Our servers' processes, sampled from the kernel, with no change to their
// code: where their CPU goes, as flame graphs in Pyroscope.
discovery.relabel "servers" {
  targets = discovery.relabel.containers.output

  rule {
    source_labels = ["service"]
    regex         = "server|frost|server-next|frost-next|login|saver"
    action        = "keep"
  }

  rule {
    source_labels = ["service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "__container_id__"
  }
}

pyroscope.ebpf "servers" {
  targets    = discovery.relabel.servers.output
  forward_to = [pyroscope.write.pyroscope.receiver]
  // nanommo::Server::Tick, rather than _ZN7nanommo6Server4TickEv.
  demangle   = "simplified"
}

pyroscope.write "pyroscope" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}
