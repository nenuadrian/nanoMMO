discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=nanommo"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  forward_to    = [loki.write.loki.receiver]
  relabel_rules = loki.relabel.streams.rules
}

loki.relabel "streams" {
  forward_to = []

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  rule {
    source_labels = ["service", "__meta_docker_container_log_stream"]
    regex         = "(server|frost|server-next|frost-next|login|saver);stderr"
    target_label  = "level"
    replacement   = "error"
  }

  rule {
    source_labels = ["service", "__meta_docker_container_log_stream"]
    regex         = "(server|frost|server-next|frost-next|login|saver);stdout"
    target_label  = "level"
    replacement   = "info"
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Our servers' processes, sampled from the kernel, with no change to their
// code: where their CPU goes, as flame graphs in Pyroscope.
discovery.relabel "servers" {
  targets = discovery.relabel.containers.output

  rule {
    source_labels = ["service"]
    regex         = "server|frost|server-next|frost-next|login|saver"
    action        = "keep"
  }

  rule {
    source_labels = ["service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "__container_id__"
  }
}

pyroscope.ebpf "servers" {
  targets    = discovery.relabel.servers.output
  forward_to = [pyroscope.write.pyroscope.receiver]
  // nanommo::Server::Tick, rather than _ZN7nanommo6Server4TickEv.
  demangle   = "simplified"
}

pyroscope.write "pyroscope" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}

// Spans from our servers, in OpenTelemetry's protocol over HTTP, as JSON.
// Alloy keeps the traces worth keeping, gathers them into batches, and sends
// those on to Tempo, over gRPC.
otelcol.receiver.otlp "servers" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.tail_sampling.servers.input]
  }
}

// Which traces to keep is decided once each is whole, from all its spans, so
// it can keep the ones that went wrong or were slow, which a decision made as
// a trace starts couldn't know. A trace is taken as whole ten seconds after its
// first span, as a trade's waits up to five seconds for the saver. A trace is
// kept if any of these keeps it.
otelcol.processor.tail_sampling "servers" {
  decision_wait = "10s"

  // A span that comes after its trace's decision, such as a hello from a token
  // issued thirty seconds before, follows it.
  decision_cache = {
    sampled_cache_size     = 100000,
    non_sampled_cache_size = 100000,
  }

  // Each trace with an error: those are the ones we'll want to read.
  policy {
    name = "errors"
    type = "status_code"

    status_code {
      status_codes = ["ERROR"]
    }
  }

  // Each trace that took over 100 milliseconds: a slow request is what the
  // metrics can't explain.
  policy {
    name = "slow"
    type = "latency"

    latency {
      threshold_ms = 100
    }
  }

  // And a tenth of the rest, by their ids, to see what a normal one looks
  // like. Tempo's metrics are made from what's kept, so they count a tenth of
  // the quick ones.
  policy {
    name = "a_tenth_of_the_rest"
    type = "probabilistic"

    probabilistic {
      sampling_percentage = 10
    }
  }

  output {
    traces = [otelcol.processor.batch.servers.input]
  }
}

otelcol.processor.batch "servers" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    // Inside Compose's network, as Loki and Pyroscope are reached.
    tls {
      insecure = true
    }
  }
}
